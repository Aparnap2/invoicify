# Invoicify Environment Configuration
# Copy this file to .env.local and fill in your values

# ─────────────────────────────────────────────────────────────────────────────
# SARVAM API (Required for Voice Agent - STT + TTS)
# Get your API key: https://platform.sarvam.ai
# Free tier: ~150 minutes of calls, 1000 transcriptions
# ─────────────────────────────────────────────────────────────────────────────
SARVAM_API_KEY=your_sarvam_api_key_here

# Sarvam STT Configuration (Saaras v3)
SARVAM_STT_MODEL=saaras:v3
SARVAM_STT_MODE=transcribe  # transcribe | translate | codemix

# Sarvam TTS Configuration (Bulbul v3)
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=meera    # meera | arjun | other available speakers
SARVAM_TTS_PITCH=0          # -10 to 10
SARVAM_TTS_PACE=1.1         # 0.5 to 2.0
SARVAM_TTS_LOUDNESS=1.0     # 0.5 to 2.0
SARVAM_TTS_SAMPLE_RATE=8000 # 8000 for telephony (Twilio), 16000 for high quality

# Vendor Language (for voice calls)
VENDOR_LANGUAGE=hi-IN  # hi-IN, gu-IN, mr-IN, en-US, etc.

# ─────────────────────────────────────────────────────────────────────────────
# LLM PROVIDER (Azure AI via OpenAI SDK)
# ─────────────────────────────────────────────────────────────────────────────

# Azure AI Foundry (Production + Local with credentials)
LLM_PROVIDER=azure
AZURE_OPENAI_KEY=your_azure_openai_key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# Optional: Ollama fallback (uses your existing container)
# LLM_PROVIDER=ollama
# OLLAMA_MODEL=qwen2.5:7b
# OLLAMA_BASE_URL=http://localhost:11434/v1

# ─────────────────────────────────────────────────────────────────────────────
# DATABASE (Local Development)
# ─────────────────────────────────────────────────────────────────────────────

# SQL Server (Azure SQL local emulator)
DATABASE_URL=Server=localhost,1433;Database=invoicify;User=sa;Password=DevPass123!;TrustServerCertificate=true

# Cosmos DB (MongoDB API emulator)
COSMOS_DB_URL=mongodb://localhost:10255
COSMOS_DB_KEY=C2y6yDjf5/R+ob0N8A7Cgv30VRDJIWEHLM+4QDU5DE2nQ9nDuVTqobD4b8mGGyPMbIZnqyMcpkfkCViLHxUXoA==

# Redis (Trust Battery cache)
REDIS_URL=redis://localhost:6379

# Qdrant (Vector search for RAG)
AZURE_SEARCH_ENDPOINT=http://localhost:6333

# ─────────────────────────────────────────────────────────────────────────────
# EVENT GRID (Mocked locally via Mockoon)
# ─────────────────────────────────────────────────────────────────────────────
EVENT_GRID_ENDPOINT=http://localhost:3001/eventgrid
EVENT_GRID_KEY=mock-key

# ─────────────────────────────────────────────────────────────────────────────
# QUICKBOOKS (Mocked locally)
# ─────────────────────────────────────────────────────────────────────────────
QUICKBOOKS_BASE_URL=http://localhost:3001/v3/company
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# SIGNALR (Real-time updates - Mocked locally)
# ─────────────────────────────────────────────────────────────────────────────
SIGNALR_CONNECTION_STRING=Endpoint=http://localhost:3001;AccessKey=devkey

# ─────────────────────────────────────────────────────────────────────────────
# TWILIO (Optional - For Voice RFP Calling)
# Get your credentials: https://console.twilio.com
# Free trial: ~150 minutes, verified numbers only
# ─────────────────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_VERIFIED_NUMBERS=+91XXXXXXXXXX,+1XXXXXXXXXX

# Voice Agent Public URL (for Twilio webhooks - use ngrok for local dev)
VOICE_AGENT_PUBLIC_URL=https://your-ngrok-url.ngrok.io

# ─────────────────────────────────────────────────────────────────────────────
# AZURE MONITOR (Optional - For Production Observability)
# ─────────────────────────────────────────────────────────────────────────────
AZURE_MONITOR_CONNECTION_STRING=

# ─────────────────────────────────────────────────────────────────────────────
# APP CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────
APP_ENV=development  # development | staging | production
LOG_LEVEL=DEBUG      # DEBUG | INFO | WARNING | ERROR
