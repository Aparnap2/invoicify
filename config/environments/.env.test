# Test Environment Configuration
# This file is for testing only and should not be committed to git

# Basic Application Settings
PROJECT_NAME="AP Intake Validation Test"
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=test-secret-key-for-development-only-change-in-production
REQUIRE_HTTPS=false

# Database Configuration (Test Ports)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/ap_intake
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis Configuration (Test Ports)
REDIS_URL=redis://localhost:6381/0

# Storage Configuration (Test Ports)
STORAGE_TYPE=s3
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin123
AWS_REGION=us-east-1
S3_BUCKET_NAME=ap-intake-documents
S3_ENDPOINT_URL=http://localhost:9004

# Gmail OAuth Configuration
# IMPORTANT: These are test credentials - replace with your own for real testing
GMAIL_CLIENT_ID=your-gmail-client-id-here
GMAIL_CLIENT_SECRET=your-gmail-client-secret-here
GCP_PROJECT_ID=your-gcp-project-id-here
GMAIL_PUBSUB_TOPIC_NAME=gmail-invoice-notifications
GMAIL_PUBSUB_SUBSCRIPTION_NAME=gmail-invoice-subscription
GMAIL_WEBHOOK_URL=http://localhost:8001/api/v1/gmail/gmail-webhook

# Email Processing Configuration
EMAIL_INGESTION_ENABLED=true
EMAIL_MONITORING_INTERVAL_MINUTES=60
EMAIL_MAX_PROCESSING_DAYS=7
EMAIL_SECURITY_VALIDATION_ENABLED=true
EMAIL_AUTO_PROCESS_INVOICES=true

# LLM Configuration
LLM_PROVIDER=openrouter
LLM_MODEL=z-ai/glm-4.5-air:free
OPENROUTER_API_KEY=your-openrouter-key-here
LLM_MAX_TOKENS=1000
LLM_TEMPERATURE=0.1

# Docling Configuration
DOCLING_CONFIDENCE_THRESHOLD=0.85
DOCLING_MAX_PAGES=50
DOCLING_TIMEOUT=30

# Worker Configuration
WORKER_CONCURRENCY=4
WORKER_PREFETCH_MULTIPLIER=1
WORKER_TASK_SOFT_TIME_LIMIT=300
WORKER_TASK_TIME_LIMIT=600

# File Handling
MAX_FILE_SIZE_MB=25
ALLOWED_FILE_TYPES=pdf,jpeg,jpg,png

# UI Configuration
UI_HOST=http://localhost:3001
API_HOST=http://localhost:8001

# Integration Configuration
USE_SWAPPABLE_INTEGRATION=true
INTEGRATION_DEFAULT_PROVIDER=native
INTEGRATION_FALLBACK_ENABLED=true
INTEGRATION_AUTO_FAILOVER=true

# Logging
LOG_LEVEL=INFO

# Monitoring (Disabled for test)
SENTRY_DSN=
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=

# QuickBooks (Test Configuration)
QUICKBOOKS_SANDBOX_CLIENT_ID=test-client-id
QUICKBOOKS_SANDBOX_CLIENT_SECRET=test-client-secret
QUICKBOOKS_REDIRECT_URI=http://localhost:8001/api/v1/quickbooks/callback
QUICKBOOKS_ENVIRONMENT=sandbox