          "body": "{\n  \"Bill\": {\n    \"VendorRef\": {\n      \"value\": \"{{body 'VendorRef.value'}}\",\n      \"name\": \"{{body 'VendorRef.name'}}\"\n    },\n    \"TxnDate\": \"{{body 'TxnDate'}}\",\n    \"DueDate\": \"{{body 'DueDate'}}\",\n    \"DocNumber\": \"{{body 'DocNumber'}}\",\n    \"Line\": {{body 'Line'}},\n    \"TotalAmt\": {{body 'TotalAmt'}},\n    \"Balance\": {{body 'Balance'}},\n    \"Id\": \"{{url 'id'}}\",\n    \"SyncToken\": \"1\",\n    \"domain\": \"QBO\",\n    \"sparse\": false,\n    \"MetaData\": {\n      \"CreateTime\": \"2025-01-01T00:00:00-08:00\",\n      \"LastUpdatedTime\": \"{{now}}\"\n    }\n  },\n  \"time\": \"{{now}}\"\n}",
          "latency": 200,
