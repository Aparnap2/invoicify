{
  "uuid": "groq-api-mock",
  "name": "Groq API Mock",
  "endpointPrefix": "",
  "port": 3000,
  "routes": [
    {
      "uuid": "groq-chat-completions",
      "method": "post",
      "endpoint": "openai/v1/chat/completions",
      "responses": [
        {
          "uuid": "groq-extract-invoice",
          "label": "Extract Invoice",
          "body": "{\n  \"id\": \"chatcmpl-mock-extract\",\n  \"object\": \"chat.completion\",\n  \"created\": 1700000000,\n  \"model\": \"llama-3.2-90b-vision-preview\",\n  \"choices\": [{\n    \"index\": 0,\n    \"message\": {\n      \"role\": \"assistant\",\n      \"content\": \"{\\\"vendor_name\\\": \\\"Acme Corporation\\\", \\\"total_amount\\\": 1500.00, \\\"invoice_number\\\": \\\"INV-2024-001\\\", \\\"due_date\\\": \\\"2025-03-15\\\", \\\"currency\\\": \\\"USD\\\", \\\"line_items\\\": [{\\\"description\\\": \\\"Consulting Services\\\", \\\"quantity\\\": 10, \\\"unit_price\\\": 150.00, \\\"amount\\\": 1500.00}]}\"\n    },\n    \"finish_reason\": \"stop\"\n  }]\n}",
          "latency": 500,
          "statusCode": 200,
          "rules": [
            {
              "target": "body",
              "modifier": "",
              "value": "invoice",
              "operator": "contains",
              "invert": false
            }
          ]
        },
        {
          "uuid": "groq-default",
          "label": "Default Response",
          "body": "{\n  \"id\": \"chatcmpl-mock-default\",\n  \"object\": \"chat.completion\",\n  \"created\": 1700000000,\n  \"model\": \"llama-3.2-90b-vision-preview\",\n  \"choices\": [{\n    \"index\": 0,\n    \"message\": {\n      \"role\": \"assistant\",\n      \"content\": \"Mock response from Groq\"\n    },\n    \"finish_reason\": \"stop\"\n  }]\n}",
          "latency": 100,
          "statusCode": 200
        }
      ]
    },
    {
      "uuid": "groq-health",
      "method": "get",
      "endpoint": "health",
      "responses": [
        {
          "uuid": "groq-health-ok",
          "body": "{\"status\": \"ok\"}",
          "latency": 10,
          "statusCode": 200
        }
      ]
    }
  ]
}
