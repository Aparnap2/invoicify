!.env.example
.dev.vars
.vars
.env.local
.env.*.local
*.pem
*.key
*.crt
*.secret
*.password
secrets/
.secrets.baseline
*.credentials
*credentials.json
*service-account.json

# ── Build Artifacts ─────────────────────────────────────────────────────────
.next/
out/
build/
dist/
*.so
*.py[cod]
*$py.class
*.egg-info/
*.egg
*.tsbuildinfo
.turbo/
.vercel/
.wrangler/

# ── IDE & Editor ────────────────────────────────────────────────────────────
