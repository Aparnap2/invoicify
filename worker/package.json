{
  "name": "invoicify-worker",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "esbuild src/index.ts --bundle --outfile=dist/index.js --format=esm --loader:.json=file --loader:.html=text --minify --platform=browser --target=es2022",
    "build:dev": "esbuild src/index.ts --bundle --outfile=dist/index.js --format=esm --loader:.json=file --platform=browser --target=es2022",
    "check": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:push": "wrangler d1 execute invoicify-db --local --file=$(ls drizzle/migrations/*.sql | head -1)",
    "db:studio": "drizzle-kit studio",
    "db:migrate": "wrangler d1 migrations apply invoicify-db"
  },
  "dependencies": {
    "@upstash/kafka": "^1.3.5",
    "drizzle-orm": "^0.38.0",
    "hono": "^4.6.0",
    "neo4j-driver": "^6.0.1",
    "uuid": "^11.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241218.0",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.0.17",
    "@vitest/ui": "^4.0.17",
    "drizzle-kit": "^0.30.0",
    "typescript": "^5.7.0",
    "vitest": "^4.0.17",
    "wrangler": "^4.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
