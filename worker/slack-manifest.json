{
  "display_information": {
    "name": "Invoicify - Finance Intern",
    "description": "Your AI Finance Intern - asks before paying, knows your numbers, remembers your preferences",
    "background_color": "#1a1a2e",
    "long_description": "The Finance Intern that lives in Slack. Just ask: \"How much runway do we have?\" or \"Did we pay Acme?\" It proactively alerts you on suspicious invoices and remembers your preferences like \"Auto-approve Vercel under $500\"."
  },
  "features": {
    "app_home": {
      "home_tab_enabled": true,
      "messages_tab_enabled": true,
      "messages_tab_read_only_enabled": true
    },
    "slash_commands": [
      {
        "command": "/intern",
        "url": "https://your-worker.workers.dev/api/v1/slack/intern/command",
        "description": "Ask your Finance Intern anything",
        "usage_hint": "[question or instruction]",
        "should_escape": false
      }
    ],
    "workflows": [],
    "interactivity": {
      "interactivity_enabled": true,
      "accepts_url_verification": true
    },
    "event_subscriptions": {
      "enabled": true,
      "url": "https://your-worker.workers.dev/api/v1/slack/intern/events",
      "subscribe_events": [
        "app_mention",
        "message.im"
      ],
      "request_url_verification": {
        "type": "url_verification"
      }
    },
    "bot_user": {
      "display_name": "Finance Intern",
      "always_online": true,
      "presence_subtype": "default"
    },
    "org_deploy_enabled": true,
    "socket_mode_enabled": false
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "app_mentions:read",
        "channels:history",
        "chat:write",
        "chat:write.public",
        "commands",
        "im:history",
        "im:read",
        "im:write",
        "users:read"
      ]
    }
  },
  "settings": {
    "event_subscriptions_app_level_warnings": {
    },
    "html_url": "",
    "token_rotation": {
      "enabled": false
    }
  }
}
