# Invoicify Worker Environment Variables
# Copy this to .env and fill in the values

# Cloudflare (get from Cloudflare Dashboard)
CLOUDFLARE_DATABASE_ID=your-d1-database-id
CLOUDFLARE_KV_CACHE_ID=your-kv-cache-id

# Upstash Kafka (get from https://console.upstash.com/kafka)
# Create a Kafka cluster and get these credentials
UPSTASH_KAFKA_REST_URL=https://your-cluster.upstash.io
UPSTASH_KAFKA_REST_USERNAME=your-username
UPSTASH_KAFKA_REST_PASSWORD=your-password

# Neo4j Aura (get from https://console.neo4j.io)
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-password

# API Security
API_SECRET_KEY=your-secret-key-here

# QuickBooks Integration (optional)
# QUICKBOOKS_CLIENT_ID=your-client-id
# QUICKBOOKS_CLIENT_SECRET=your-client-secret
# QUICKBOOKS_REFRESH_TOKEN=your-refresh-token
# QUICKBOOKS_REALM_ID=your-realm-id

# Slack Integration (optional)
# SLACK_BOT_TOKEN=xoxb-your-bot-token
# SLACK_SIGNING_SECRET=your-signing-secret

# Stripe Integration (optional)
# STRIPE_TEST_KEY=sk_test_your-key
